<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Выход из аккаунта с любого экрана: очищаем стек и открываем вход -->
    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.notes.ui.auth.SplashFragment">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_notes"
            app:destination="@id/notesFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.notes.ui.auth.LoginFragment">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_login_to_notes"
            app:destination="@id/notesFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.notes.ui.auth.RegisterFragment">
        <action
            android:id="@+id/action_register_to_notes"
            app:destination="@id/notesFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/notesFragment"
        android:name="com.example.notes.ui.notes.NotesFragment"
        android:label="@string/title_notes" />

    <fragment
        android:id="@+id/foldersFragment"
        android:name="com.example.notes.ui.folders.FoldersFragment"
        android:label="@string/title_folders" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.notes.ui.notes.FavoritesFragment"
        android:label="@string/title_favorites" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.notes.ui.profile.ProfileFragment"
        android:label="@string/title_profile" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.notes.ui.search.SearchFragment"
        android:label="@string/title_search" />

    <fragment
        android:id="@+id/noteEditFragment"
        android:name="com.example.notes.ui.notes.NoteEditFragment"
        android:label="@string/title_new_note" />

    <fragment
        android:id="@+id/noteDetailFragment"
        android:name="com.example.notes.ui.notes.NoteDetailFragment"
        android:label="@string/title_note" />

    <fragment
        android:id="@+id/folderNotesFragment"
        android:name="com.example.notes.ui.notes.FolderNotesFragment"
        android:label="{folderName}">
        <argument
            android:name="folderId"
            app:argType="long" />
        <argument
            android:name="folderName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/trashFragment"
        android:name="com.example.notes.ui.notes.TrashFragment"
        android:label="@string/title_trash" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.example.notes.ui.profile.AboutFragment"
        android:label="@string/title_about" />
</navigation>
